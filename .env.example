# ---- Core ----
DEBUG=True
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database ----
# Local dev (default): leave DATABASE_URL empty, SQLite is used automatically.
# Local Postgres: set DATABASE_ENGINE=postgres and fill in the DB_* vars below.
# Production (Render/Railway/Heroku): set DATABASE_URL - it overrides everything below.
DATABASE_URL=
DATABASE_ENGINE=sqlite
DB_NAME=smartrecruit_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ---- Production security (only used when DEBUG=False) ----
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# ---- CORS (only needed if a separate frontend calls this as an API) ----
CORS_ALLOWED_ORIGINS=

# ---- AI (optional, app works fully without it) ----
GEMINI_API_KEY=
